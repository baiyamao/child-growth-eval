{
  "name": "child-growth-eval",
  "version": "2.0.1",
  "description": "基于 WS/T 423—2022 的 7 岁以下儿童生长水平与营养状况评价工具包。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "references/china_growth_standard_2022.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "generate:standard": "python3 scripts/generate_china_standard.py references/7岁以下儿童生长标准.xlsx references/china_growth_standard_2022.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baiyamao/child-growth-eval.git"
  },
  "keywords": [
    "child",
    "growth",
    "evaluation",
    "WS/T 423-2022",
    "中国儿童生长标准",
    "儿童",
    "生长发育",
    "儿童健康"
  ],
  "author": "baiyamao",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/baiyamao/child-growth-eval/issues"
  },
  "homepage": "https://github.com/baiyamao/child-growth-eval#readme",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  }
}
